from wavy.utils.io import make_pathtofile, make_subdict, NoStdStreams, get_size


class TestMakeSubdict:
    def test_present_keys(self):
        result = make_subdict(["a", "b"], class_object_dict={"a": 1, "b": 2, "c": 3})
        assert result == {"a": 1, "b": 2}

    def test_missing_key_excluded(self):
        result = make_subdict(["x"], class_object_dict={"a": 1})
        assert "x" not in result

    def test_none_strsublst(self):
        result = make_subdict(None, class_object_dict={"a": 1})
        assert result == {}


class TestMakePathtofile:
    def test_simple_substitution(self):
        path = make_pathtofile("/data/{nID}/file.nc", ["{nID}"], {"{nID}": "s3a"})
        assert path == "/data/s3a/file.nc"

    def test_date_strftime(self):
        date = datetime(2023, 6, 15)
        path = make_pathtofile("/data/%Y/%m/file.nc", None, {}, date=date)
        assert path == "/data/2023/06/file.nc"

    def test_missing_key_leaves_path_unchanged(self):
        # key not in subdict → template left as-is
        path = make_pathtofile("/data/{nID}/file.nc", ["{nID}"], {})
        assert "{nID}" in path


class TestNoStdStreams:
    def test_suppresses_stdout(self):
        captured = io.StringIO()
        with NoStdStreams(stdout=captured):
            print("should be suppressed")
        assert captured.getvalue() == "should be suppressed\n"

    def test_restores_stdout_after(self):
        original = sys.stdout
        with NoStdStreams():
            pass
        assert sys.stdout is original


class TestGetSize:
    def test_int_positive(self):
        assert get_size(42) > 0

    def test_list_larger_than_empty(self):
        assert get_size([1, 2, 3]) > get_size([])

    def test_nested_dict(self):
        assert get_size({"a": {"b": 1}}) > get_size({})


# ---------------------------------------------------------------------------
# utils.misc
# ---------------------------------------------------------------------------

from wavy.utils.misc import flatten, finditem, get_item_parent, get_item_child


class TestFlatten:
    def test_simple(self):
        assert flatten([[1, 2], [3, 4]]) == [1, 2, 3, 4]

    def test_empty_inner(self):
        assert flatten([[], [1], []]) == [1]

    def test_empty(self):
        assert flatten([]) == []

    def test_single_element_lists(self):
        assert flatten([[1], [2], [3]]) == [1, 2, 3]


class TestFinditem:
    nested = {
        "a": 1,
        "b": {"c": 2, "d": {"e": 3}},
        "f": [{"g": 4}, {"g": 5}],
    }

    def test_top_level_key(self):
        assert finditem(self.nested, "a") == [1]

    def test_nested_key(self):
        assert finditem(self.nested, "e") == [3]

    def test_key_in_list_of_dicts(self):
        result = finditem(self.nested, "g")
        assert set(result) == {4, 5}

    def test_missing_key(self):
        assert finditem(self.nested, "z") == []


class TestGetItemParent:
    ncdict = {
        "var1": {"standard_name": "sea_surface_wave_significant_height", "units": "m"},
        "var2": {"standard_name": "wind_speed", "units": "m s-1"},
    }

    def test_finds_by_standard_name(self):
        result = get_item_parent(self.ncdict, "significant_height", "standard_name")
        assert "var1" in result

    def test_no_match_returns_none(self):
        result = get_item_parent(self.ncdict, "temperature", "standard_name")
        assert result is None


class TestGetItemChild:
    ncdict = {
        "time": {"standard_name": "time", "units": "seconds since 1970-01-01"},
        "Hs": {"standard_name": "sea_surface_wave_significant_height", "units": "m"},
    }

    def test_finds_child(self):
        result = get_item_child(self.ncdict, "time")
        assert len(result) == 1
        assert result[0]["standard_name"] == "time"

    def test_missing_returns_empty(self):
        assert get_item_child(self.ncdict, "nonexistent") == []


# ---------------------------------------------------------------------------
# Backward-compatibility: everything importable from wavy.utils directly
# ---------------------------------------------------------------------------


def test_backward_compat_imports():
    from wavy.utils import (
        parse_date,
        flatten,
        haversineA,
        make_pathtofile,
        collocate_times,
        runmean,
        build_xr_ds,
        footprint_pulse_limited_radius,
        NoStdStreams,
        finditem,
        marginalize,
    )

    assert callable(parse_date)
    assert callable(flatten)
    assert callable(haversineA)
